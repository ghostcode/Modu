{
  "name": "modu",
  "version": "0.2.7",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/library.test.mjs tests/appearance.test.mjs tests/article-date.test.mjs tests/save-queue.test.mjs tests/updater.test.mjs tests/release.test.mjs tests/lifecycle.test.mjs",
    "dev:desktop": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "tauri:dev": "tauri dev",
    "tauri:build": "node scripts/build-desktop.mjs",
    "tauri:build:windows": "node scripts/build-windows.mjs",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml",
    "package:mac": "node scripts/package-macos.mjs",
    "release:version": "node scripts/version.mjs",
    "release:manifest": "node scripts/release-manifest.mjs",
    "release:verify": "node scripts/verify-published.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@tauri-apps/api": "^2.12.5",
    "@vitejs/plugin-react": "5.0.4",
    "dompurify": "^3.4.18",
    "highlight.js": "11.12.0",
    "katex": "0.19.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
